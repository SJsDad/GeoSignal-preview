# JetBrains / PyCharm
.idea/

# OS generated files
Thumbs.db
.DS_Store

# Python cache, just in case
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Local temporary files
tmp/
temp/
_tmp/
*.tmp
*.log

# Local generated outputs
outputs/
results/
reports/

# Large/private layout data
*.gds
*.oas
*.gds.gz
*.oas.gz

# Private notes or drafts
private/
drafts/
internal/

# Verified public TT04 review artifacts
!docs/assets/demo/v0.10/*/pya_native_combined_review.gds

# This exact folder contains reviewed public preset results, not private notes.
!docs/assets/demo/v0.10/internal/
!docs/assets/demo/v0.10/internal/*
